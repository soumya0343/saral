# syntax=docker/dockerfile:1
# One image for every Python process: api (default CMD), worker and migrate override the command
# (docker-compose.yml, fly.toml [processes], render.yaml dockerCommand).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Layers are ordered slowest-changing first, so a code edit rebuilds only the last COPY.

# Install deps first (cached layer).
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
# Local multilingual-e5 (cross-lingual retrieval — the differentiator: an English query must
# match Hindi docs). Install CPU-only torch first to avoid the multi-GB CUDA wheels, then
# sentence-transformers (sees torch already satisfied).
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install sentence-transformers

# Bake the e5 weights in (before any source COPY, so code/data edits don't re-download them).
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('intfloat/multilingual-e5-small')"
# The weights are local now: skip the Hub round-trips on every model load.
ENV HF_HUB_OFFLINE=1

COPY alembic.ini ./alembic.ini
# Policy corpus, per-customer docs, and eval scenarios are read from data/ at runtime.
COPY data ./data
COPY backend ./backend

EXPOSE 8000
CMD ["uvicorn", "saral.api.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--app-dir", "backend"]
