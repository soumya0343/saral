# syntax=docker/dockerfile:1
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS base

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Install deps first (cached layer). multilingual-e5 (cross-lingual retrieval) is needed because
# the eval endpoint exercises RAG. CPU-only torch first to avoid multi-GB CUDA wheels.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && uv pip install sentence-transformers

# App source
COPY backend ./backend
COPY alembic.ini ./alembic.ini

# Policy corpus, per-customer docs, and eval scenarios are read from data/ at runtime.
COPY data ./data

# Pre-download the e5 weights at build time so the first request isn't slow.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('intfloat/multilingual-e5-small')"

EXPOSE 8000
CMD ["uvicorn", "saral.api.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--app-dir", "backend"]
