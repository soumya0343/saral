# Copy to .env and fill as needed. All keys optional in dev (stub LLM fallback).

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://saral:saral@localhost:5432/saral
REDIS_URL=redis://localhost:6379/0

# --- Identity & Auth (mock IdP) ---
# REQUIRED in prod: >=32-byte HMAC key for signing session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=dev-insecure-change-me-0000000000000000
SESSION_TTL_MIN=30
STEP_UP_TTL_S=300
DEFAULT_TENANT=t_demo
# Surface the step-up OTP in API responses (no SMS channel); auto-off when APP_ENV=prod.
EXPOSE_TEST_OTP=true

# --- Redis Streams run bus ---
RUN_STREAM=agent-runs
RUN_CONSUMER_GROUP=workers

# --- LLM providers (leave blank to use deterministic stub) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
ANTHROPIC_API_KEY=
LLM_PROVIDER_ORDER=gemini,groq,cerebras,stub
ANTHROPIC_MODEL=claude-sonnet-4-6
# Available chat models: sarvam-30b, sarvam-105b (sarvam-m is deprecated). Reasoning models —
# give them headroom (max_tokens >= 512) or content comes back empty and triggers fallback.
SARVAM_MODEL=sarvam-30b
# Sarvam is used ONLY for language detection (/text-lid, en/hi/hinglish) — never as a chat
# provider. Falls back to the deterministic regex detector when unset or Sarvam is unreachable.
TRIAGE_LLM_LANGUAGE=true

# Free-tier chat providers (OpenAI-compatible). Per-role routing: Gemini Flash for synthesis
# (Hindi-strong), Groq/Cerebras Llama for fast triage classify. Generation never uses Sarvam.
# Each key var accepts MULTIPLE comma-separated keys — they are rotated round-robin and on 429
# to spread free-tier rate limits (e.g. GEMINI_API_KEY=key1,key2,key3).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b
# Per-role provider chains (blank -> falls back to LLM_PROVIDER_ORDER). No Sarvam here.
LLM_ROLE_SYNTHESIS=gemini,groq,cerebras,stub
LLM_ROLE_TRIAGE=groq,cerebras,stub
LLM_ROLE_JUDGE=gemini,stub

# --- Retrieval / embeddings ---
# Live path: local multilingual-e5 (cross-lingual semantics for Hindi/Hinglish per-customer
# retrieval — the differentiator). Needs the `embeddings` extra: uv sync --extra embeddings
# First run downloads ~120MB weights. Set EMBEDDER=hashing for the dependency-free CI floor.
EMBEDDER=sentence-transformer
EMBEDDER_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_TOP_K=4
# Below this top-passage score an information answer escalates as ungrounded (e5 cosine scale).
RETRIEVAL_SCORE_FLOOR=0.0

# --- Compliance ---
# Redact gate. "regex" (default) is dependency-free + deterministic for CI. In prod set
# "presidio" (needs the `pii` extra: uv sync --extra pii) for NER names/locations, layered
# over the regex India-PII patterns. Falls back to regex automatically if the extra is absent.
PII_BACKEND=regex
MESSAGE_RETENTION_DAYS=90
AUDIT_RETENTION_YEARS=7
# Suspended-write authority TTL (seconds): past this, a pending write is abandoned, never fires.
PENDING_WRITE_TTL_S=86400
ORPHAN_TTL_S=86400

# --- Agent control ---
MAX_STEP_COUNT=25
TOOL_TIMEOUT_S=10.0
CONVERSATION_MEMORY_TURNS=8
