# Copy to .env and fill as needed. All keys optional in dev (stub LLM fallback).

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://saral:saral@localhost:5432/saral
REDIS_URL=redis://localhost:6379/0

# --- Redis Streams run bus ---
RUN_STREAM=agent-runs
RUN_CONSUMER_GROUP=workers

# --- LLM providers (leave blank to use deterministic stub) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
ANTHROPIC_API_KEY=
LLM_PROVIDER_ORDER=sarvam,anthropic,stub
ANTHROPIC_MODEL=claude-sonnet-4-6
SARVAM_MODEL=sarvam-m

# --- Agent control ---
MAX_STEP_COUNT=25
TOOL_TIMEOUT_S=10.0
CONVERSATION_MEMORY_TURNS=8
